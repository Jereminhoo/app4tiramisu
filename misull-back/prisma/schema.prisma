// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id_utilisateur Int        @id @default(autoincrement())
  pseudo         String     @unique
  motDePasse     String
  role           String     @default("CLIENT")
  pointsFidelite Int        @default(0)
  estBanni       Boolean    @default(false)
  commandes      Commande[]
}

model Tiramisu {
  id_tiramisu      Int             @id @default(autoincrement())
  nom              String
  description      String?
  listeIngredients String
  lignesCommande   LigneCommande[]
}

model Taille {
  id_taille      Int             @id @default(autoincrement())
  nom            String
  prix           Float
  lignesCommande LigneCommande[]
}

model Supplement {
  id_supplement  Int             @id @default(autoincrement())
  nom            String
  prix           Float           @default(0.80)
  lignesCommande LigneCommande[] @relation("LigneToSupplement")
}

// Les 3 goûts disponibles : Oreo, Spéculoos, Petit Beurre
model Gout {
  id_gout        Int             @id @default(autoincrement())
  nom            String
  lignesCommande LigneCommande[]
}

model Commande {
  id_commande    Int             @id @default(autoincrement())
  id_utilisateur Int
  dateCreation   DateTime        @default(now())
  dateRetrait    DateTime?
  livraisonSamedi Boolean       @default(false)
  statut         String          @default("EN_ATTENTE")
  prixTotal      Float
  // Code court unique remis au client pour récupérer sa commande
  // Ex: "A3F9K2" — généré automatiquement à la création
  codeRetrait    String?         @unique
  utilisateur    Utilisateur     @relation(fields: [id_utilisateur], references: [id_utilisateur])
  lignes         LigneCommande[]
}

model LigneCommande {
  id_ligne     Int        @id @default(autoincrement())
  id_commande  Int
  id_tiramisu  Int
  id_taille    Int
  id_gout      Int        // Le goût choisi par le client
  quantite     Int        @default(1)

  commande     Commande   @relation(fields: [id_commande], references: [id_commande])
  tiramisu     Tiramisu   @relation(fields: [id_tiramisu], references: [id_tiramisu])
  taille       Taille     @relation(fields: [id_taille], references: [id_taille])
  gout         Gout       @relation(fields: [id_gout], references: [id_gout])
  supplements  Supplement[] @relation("LigneToSupplement")
}